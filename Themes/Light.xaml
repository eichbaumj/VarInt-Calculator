<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme: pale surfaces and ink text. As in Firefly's light theme, the ribbon stays
         navy, so everything on it keeps the light-on-dark brushes. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="RibbonBrush" Color="#1B293B"/>
    <SolidColorBrush x:Key="ModeBarBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="#DCE3EC"/>

    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DisplayBorderBrush" Color="#D5DCE5"/>
    <SolidColorBrush x:Key="SheetBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#EAF0F8"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#DCE3EC"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#101828"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#435D78"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5B7190"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1046DC"/>
    <SolidColorBrush x:Key="KickerTextBrush" Color="#7A5C00"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#C62838"/>

    <SolidColorBrush x:Key="ValidBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="PendingBrush" Color="#C9A227"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62838"/>

    <SolidColorBrush x:Key="KeyDigitBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="KeyDigitHoverBrush" Color="#F3F6FA"/>
    <SolidColorBrush x:Key="KeyDigitPressedBrush" Color="#E4E9F0"/>
    <SolidColorBrush x:Key="KeyDigitBorderBrush" Color="#D5DCE5"/>
    <SolidColorBrush x:Key="KeyDigitForegroundBrush" Color="#101828"/>
    <SolidColorBrush x:Key="KeyFunctionBrush" Color="#E4E9F0"/>
    <SolidColorBrush x:Key="KeyFunctionHoverBrush" Color="#D9E0EA"/>
    <SolidColorBrush x:Key="KeyFunctionPressedBrush" Color="#CBD4E0"/>
    <SolidColorBrush x:Key="KeyFunctionBorderBrush" Color="#CBD4E0"/>
    <SolidColorBrush x:Key="KeyFunctionForegroundBrush" Color="#101828"/>
    <SolidColorBrush x:Key="KeyHexBorderBrush" Color="#1C4FD6"/>
    <SolidColorBrush x:Key="KeyDangerBorderBrush" Color="#A81F2D"/>

    <SolidColorBrush x:Key="SegmentTrackBrush" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="SegmentTrackBorderBrush" Color="#D5DCE5"/>
    <SolidColorBrush x:Key="SegmentHoverBrush" Color="#E0E6EE"/>
    <SolidColorBrush x:Key="SegmentForegroundBrush" Color="#435D78"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#B8C4D3"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#73101828"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C5CFDB"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A9B6C6"/>
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#1B293B"/>
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#1B293B"/>

    <DropShadowEffect x:Key="KeyShadow" Color="#101828" BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.12"/>
    <DropShadowEffect x:Key="CardShadow" Color="#101828" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.10"/>

</ResourceDictionary>
