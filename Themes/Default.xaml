<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Default theme: Firefly's navy surfaces with the blue accent (the values of Firefly's
         Styles/Themes/DefaultTheme.xaml: body #101923, panels #16222F / #1B293B, hairline #26364A). -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#101923"/>
    <SolidColorBrush x:Key="RibbonBrush" Color="#1B293B"/>
    <SolidColorBrush x:Key="ModeBarBackgroundBrush" Color="#16222F"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#101923"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="#26364A"/>

    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#16222F"/>
    <SolidColorBrush x:Key="DisplayBorderBrush" Color="#26364A"/>
    <SolidColorBrush x:Key="SheetBackgroundBrush" Color="#1B293B"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E2D42"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#24374E"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#26364A"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9DB9E8"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8199BB"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#439CF1"/>
    <SolidColorBrush x:Key="KickerTextBrush" Color="#FFDE59"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF6B7D"/>

    <!-- Display edge: green when the bytes read as a varint, yellow while one is still being
         typed, red when they cannot be one. -->
    <SolidColorBrush x:Key="ValidBrush" Color="#81C784"/>
    <SolidColorBrush x:Key="PendingBrush" Color="#B3FFDE59"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EE3D53"/>

    <SolidColorBrush x:Key="KeyDigitBrush" Color="#263A52"/>
    <SolidColorBrush x:Key="KeyDigitHoverBrush" Color="#2F4763"/>
    <SolidColorBrush x:Key="KeyDigitPressedBrush" Color="#1C2B3D"/>
    <SolidColorBrush x:Key="KeyDigitBorderBrush" Color="#31496A"/>
    <SolidColorBrush x:Key="KeyDigitForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="KeyFunctionBrush" Color="#1B293B"/>
    <SolidColorBrush x:Key="KeyFunctionHoverBrush" Color="#24374E"/>
    <SolidColorBrush x:Key="KeyFunctionPressedBrush" Color="#16222F"/>
    <SolidColorBrush x:Key="KeyFunctionBorderBrush" Color="#2A3D56"/>
    <SolidColorBrush x:Key="KeyFunctionForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="KeyHexBorderBrush" Color="#4A7BFA"/>
    <SolidColorBrush x:Key="KeyDangerBorderBrush" Color="#D8404F"/>

    <SolidColorBrush x:Key="SegmentTrackBrush" Color="#101923"/>
    <SolidColorBrush x:Key="SegmentTrackBorderBrush" Color="#26364A"/>
    <SolidColorBrush x:Key="SegmentHoverBrush" Color="#1E2D42"/>
    <SolidColorBrush x:Key="SegmentForegroundBrush" Color="#9DB9E8"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#121C28"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#3A4C63"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#A60A1018"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A4C63"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#4E6585"/>
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#1B293B"/>
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#31496A"/>

    <DropShadowEffect x:Key="KeyShadow" Color="#000000" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.35"/>
    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.38"/>

</ResourceDictionary>
