<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme: Firefly's charcoal surfaces (Styles/Themes/DarkTheme.xaml) with the same
         blue accent. -->

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <LinearGradientBrush x:Key="RibbonBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1E1E1E" Offset="0.0"/>
        <GradientStop Color="#252526" Offset="0.5"/>
        <GradientStop Color="#2D2D30" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ModeBarBackgroundBrush" Color="#252526"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="HairlineBrush" Color="#3F3F46"/>

    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#252526"/>
    <SolidColorBrush x:Key="DisplayBorderBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="SheetBackgroundBrush" Color="#252526"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#37373D"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3F3F46"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B9C2CC"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9DA4AC"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#439CF1"/>
    <SolidColorBrush x:Key="KickerTextBrush" Color="#FFDE59"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF6B7D"/>

    <SolidColorBrush x:Key="ValidBrush" Color="#81C784"/>
    <SolidColorBrush x:Key="PendingBrush" Color="#B3FFDE59"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EE3D53"/>

    <SolidColorBrush x:Key="KeyDigitBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="KeyDigitHoverBrush" Color="#505053"/>
    <SolidColorBrush x:Key="KeyDigitPressedBrush" Color="#2A2A2E"/>
    <SolidColorBrush x:Key="KeyDigitBorderBrush" Color="#4A4A4F"/>
    <SolidColorBrush x:Key="KeyDigitForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="KeyFunctionBrush" Color="#333337"/>
    <SolidColorBrush x:Key="KeyFunctionHoverBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="KeyFunctionPressedBrush" Color="#2A2A2E"/>
    <SolidColorBrush x:Key="KeyFunctionBorderBrush" Color="#45454A"/>
    <SolidColorBrush x:Key="KeyFunctionForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="KeyHexBorderBrush" Color="#4A7BFA"/>
    <SolidColorBrush x:Key="KeyDangerBorderBrush" Color="#D8404F"/>

    <SolidColorBrush x:Key="SegmentTrackBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SegmentTrackBorderBrush" Color="#3F3F46"/>
    <SolidColorBrush x:Key="SegmentHoverBrush" Color="#37373D"/>
    <SolidColorBrush x:Key="SegmentForegroundBrush" Color="#B9C2CC"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#4A4A4F"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#A6000000"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#505053"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6A6A6E"/>
    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#4A4A4F"/>

    <DropShadowEffect x:Key="KeyShadow" Color="#000000" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.40"/>
    <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.42"/>

</ResourceDictionary>
