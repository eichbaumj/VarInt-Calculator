<Window x:Class="VarIntCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:core="clr-namespace:VarIntCalculator.Core"
        xmlns:controls="clr-namespace:VarIntCalculator.Controls"
        xmlns:local="clr-namespace:VarIntCalculator"
        Title="Varint Calculator"
        Icon="/VarIntCalculator;component/icon.ico"
        Width="500" Height="860"
        MinWidth="490" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True">

    <!-- Firefly chrome: the ribbon is the caption bar (60 px), as on every analyzer window. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="60"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- One reading in the display: a label, the value, an optional detail line and warning,
             and a copy button (or, on the Page row, a link to the page settings). -->
        <DataTemplate x:Key="ReadingTemplate" DataType="{x:Type core:ReadingRow}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="Guide" Grid.RowSpan="2" Width="2" HorizontalAlignment="Left" Margin="3,-4,0,-8"
                        Background="{DynamicResource HairlineBrush}" Visibility="Collapsed"/>
                <TextBlock x:Name="Label" Style="{StaticResource Kicker}" Margin="0,2,8,0" TextWrapping="Wrap"
                           Text="{Binding Label, Converter={StaticResource Tracked}}"/>
                <TextBlock x:Name="SectionWarning" Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Warning}" TextWrapping="Wrap"
                           Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource KickerTextBrush}" Visibility="Collapsed"/>
                <StackPanel x:Name="ValuePanel" Grid.Column="1">
                    <TextBlock x:Name="Value" Text="{Binding Value}" TextWrapping="Wrap"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="Detail" Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,1,0,0"
                               FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock x:Name="Warning" Text="{Binding Warning}" TextWrapping="Wrap" Margin="0,2,0,0"
                               FontSize="12" Foreground="{DynamicResource KickerTextBrush}"/>
                </StackPanel>
                <Button x:Name="Copy" Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                        Margin="6,-5,0,0" Tag="{Binding}" Click="CopyReading_Click" ToolTip="Copy"
                        AutomationProperties.Name="Copy">
                    <md:PackIcon Kind="ContentCopy" Width="14" Height="14"/>
                </Button>
                <Button x:Name="Change" Grid.Column="2" Style="{StaticResource LinkButton}" VerticalAlignment="Top"
                        Margin="6,-5,-4,0" Content="Change" Click="ChangePage_Click" Visibility="Collapsed"
                        ToolTip="Page size, reserved bytes and b-tree type"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSubRow}" Value="True">
                    <Setter TargetName="Guide" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Label" Property="Text" Value="{Binding Label}"/>
                    <Setter TargetName="Label" Property="FontFamily" Value="{StaticResource BodyFont}"/>
                    <Setter TargetName="Label" Property="FontSize" Value="12.5"/>
                    <Setter TargetName="Label" Property="FontWeight" Value="Normal"/>
                    <Setter TargetName="Label" Property="Margin" Value="15,1,8,0"/>
                    <Setter TargetName="Value" Property="FontWeight" Value="Medium"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSection}" Value="True">
                    <Setter TargetName="Label" Property="Grid.ColumnSpan" Value="3"/>
                    <Setter TargetName="Label" Property="Margin" Value="0,3,0,1"/>
                    <Setter TargetName="ValuePanel" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Copy" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="SectionWarning" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Emphasis}" Value="True">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource KickerTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMono}" Value="True">
                    <Setter TargetName="Value" Property="FontFamily" Value="{StaticResource MonoFont}"/>
                    <Setter TargetName="Value" Property="FontSize" Value="15"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                    <Setter TargetName="Detail" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Warning}" Value="{x:Null}">
                    <Setter TargetName="Warning" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="SectionWarning" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CopyText}" Value="{x:Null}">
                    <Setter TargetName="Copy" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OpensPageSettings}" Value="True">
                    <Setter TargetName="Copy" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Change" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One calculation in the History sheet. -->
        <DataTemplate x:Key="HistoryItemTemplate" DataType="{x:Type local:HistoryItemView}">
            <Button Tag="{Binding}" Click="HistoryItem_Click" Focusable="False" Cursor="Hand" Margin="0,0,0,8"
                    AutomationProperties.Name="{Binding AutomationName}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Button.Template>
                <Border x:Name="Card" CornerRadius="8" BorderThickness="1" Padding="14,10,10,10"
                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource SelectCheckBox}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                  IsHitTestVisible="False" Margin="0,0,12,0"
                                  Visibility="{Binding SelectMode, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Grid.Column="1">
                            <Grid>
                                <TextBlock Text="{Binding InputDisplay}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,70,0"/>
                                <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Right" FontSize="11.5"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </Grid>
                            <TextBlock x:Name="Result" Text="{Binding Result}" FontFamily="{StaticResource LabelFont}" FontSize="19"
                                       FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,1"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource AccentTextBrush}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding ModeText, Mode=OneWay}"/><Run x:Name="SummaryRun" Text="{Binding SummaryText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <md:PackIcon Grid.Column="2" Kind="ChevronRight" Width="18" Height="18" Margin="6,0,0,0"
                                     VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"
                                     Visibility="{Binding BrowseMode, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResultIsBytes}" Value="True">
                    <Setter TargetName="Result" Property="FontFamily" Value="{StaticResource MonoFont}"/>
                    <Setter TargetName="Result" Property="FontSize" Value="17"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Storyboard x:Key="CaretBlink" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1.1">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.55" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- A maximized WindowChrome window overhangs the screen by its resize border. -->
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ ribbon -->
        <Border Grid.Row="0" Background="{DynamicResource RibbonBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Firefly's two-weight wordmark: the tool's name in the site yellow, the role in white. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,2">
                    <TextBlock Text="Varint" FontFamily="{StaticResource LabelFont}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Calculator" FontFamily="{StaticResource LabelFont}" FontSize="20" FontWeight="Normal"
                               Foreground="{StaticResource RibbonForegroundBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource HeaderButton}" VerticalAlignment="Center" Click="History_Click"
                            ToolTip="History (Ctrl+H)" AutomationProperties.Name="History">
                        <md:PackIcon Kind="History" Width="22" Height="22"/>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" VerticalAlignment="Center" Click="Settings_Click"
                            ToolTip="Settings: page size and theme" AutomationProperties.Name="Settings">
                        <md:PackIcon Kind="CogOutline" Width="22" Height="22"/>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" VerticalAlignment="Center" Click="Tutorial_Click"
                            ToolTip="Varint tutorial (F1)" AutomationProperties.Name="Tutorial">
                        <md:PackIcon Kind="SchoolOutline" Width="22" Height="22"/>
                    </Button>
                    <Button Style="{StaticResource HeaderButton}" VerticalAlignment="Center" Click="About_Click"
                            ToolTip="About" AutomationProperties.Name="About" Margin="2,0,8,0">
                        <md:PackIcon Kind="InformationOutline" Width="22" Height="22"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize"
                            AutomationProperties.Name="Minimize">
                        <md:PackIcon Kind="WindowMinimize" Width="16" Height="16"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="MaximizeRestore_Click"
                            AutomationProperties.Name="Maximize">
                        <md:PackIcon Width="16" Height="16">
                            <md:PackIcon.Style>
                                <Style TargetType="md:PackIcon">
                                    <Setter Property="Kind" Value="WindowMaximize"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Kind" Value="WindowRestore"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </md:PackIcon.Style>
                        </md:PackIcon>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseButton}" Click="Close_Click" ToolTip="Close"
                            AutomationProperties.Name="Close">
                        <md:PackIcon Kind="WindowClose" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ mode bar -->
        <Border Grid.Row="1" Background="{DynamicResource ModeBarBackgroundBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SegmentTrack}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Format" Content="SQLite"
                                     IsChecked="{Binding IsSqlite, Mode=TwoWay}"
                                     ToolTip="SQLite varints: big-endian, 1 to 9 bytes (Ctrl+1)"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Format" Content="Protobuf"
                                     IsChecked="{Binding IsProtobuf, Mode=TwoWay}"
                                     ToolTip="Protobuf varints: little-endian, 1 to 10 bytes (Ctrl+2)"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SegmentTrack}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Direction" Content="Decode"
                                     IsChecked="{Binding IsDecode, Mode=TwoWay}"
                                     ToolTip="Hex bytes to an integer (Ctrl+D)"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="Direction" Content="Encode"
                                     IsChecked="{Binding IsEncode, Mode=TwoWay}"
                                     ToolTip="An integer to varint bytes (Ctrl+E)"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================ display -->
        <Grid Grid.Row="2" Margin="16,12,16,8">
            <!-- The shadow has its own layer so the display's text keeps ClearType. -->
            <Border CornerRadius="{StaticResource CardRadius}" Background="{DynamicResource DisplayBackgroundBrush}"
                    Effect="{DynamicResource CardShadow}"/>
            <Border x:Name="DisplayCard" CornerRadius="{StaticResource CardRadius}" BorderThickness="1.5"
                    Background="{DynamicResource DisplayBackgroundBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource DisplayBorderBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Valid">
                                <Setter Property="BorderBrush" Value="{DynamicResource ValidBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Pending">
                                <Setter Property="BorderBrush" Value="{DynamicResource PendingBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Error">
                                <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="18,13,12,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Input: what is being read, and how -->
                    <Grid Grid.Row="0" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Kicker}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding InputLabel, Mode=OneWay, Converter={StaticResource Tracked}}"/><Run Text="&#x2009; &#x2009;&#x00B7;&#x2009; &#x2009;" Foreground="{DynamicResource MutedTextBrush}"/><Run Text="{Binding FormatLabel, Mode=OneWay, Converter={StaticResource Tracked}}" Foreground="{DynamicResource AccentTextBrush}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding InputCount}" FontFamily="{StaticResource LabelFont}" FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="8,0,2,0"/>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="CopyInput_Click" ToolTip="Copy the input"
                                AutomationProperties.Name="Copy the input"
                                Visibility="{Binding HasInput, Converter={StaticResource BoolToVisibility}}">
                            <md:PackIcon Kind="ContentCopy" Width="14" Height="14"/>
                        </Button>
                    </Grid>

                    <Viewbox Grid.Row="1" StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Left"
                             Height="42" Margin="0,3,6,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="InputText" Text="{Binding InputMain}" FontFamily="{StaticResource MonoFont}" FontSize="28"
                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding InputTrailing}" FontFamily="{StaticResource MonoFont}" FontSize="28"
                                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                                       ToolTip="Not part of the varint"/>
                            <Rectangle x:Name="Caret" Width="2" Height="28" Margin="3,0,0,0" VerticalAlignment="Center"
                                       Fill="{DynamicResource AccentTextBrush}">
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard Storyboard="{StaticResource CaretBlink}"/>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>
                            <TextBlock Text="{Binding Placeholder}" FontSize="19" FontStyle="Italic" Margin="8,0,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Viewbox>

                    <Rectangle Grid.Row="2" Height="1" Fill="{DynamicResource HairlineBrush}" Margin="0,0,6,10"/>

                    <!-- Results -->
                    <ScrollViewer Grid.Row="3" x:Name="ResultsScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,6,6">
                        <StackPanel>
                            <!-- Pending or error -->
                            <Grid Margin="0,2,0,6" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <md:PackIcon Width="18" Height="18" Margin="0,1,8,0" VerticalAlignment="Top">
                                    <md:PackIcon.Style>
                                        <Style TargetType="md:PackIcon">
                                            <Setter Property="Kind" Value="DotsHorizontalCircleOutline"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Kind" Value="AlertCircleOutline"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </md:PackIcon.Style>
                                </md:PackIcon>
                                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="13.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- The result -->
                            <StackPanel Visibility="{Binding HasPrimary, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Kicker}" VerticalAlignment="Center"
                                               Text="{Binding PrimaryLabel, Converter={StaticResource Tracked}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PrimaryNote}" FontSize="12" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0,4,0"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="CopyPrimary_Click"
                                            ToolTip="Copy (Ctrl+C)" AutomationProperties.Name="Copy the result" Margin="0,-4,0,-4">
                                        <md:PackIcon Kind="ContentCopy" Width="15" Height="15"/>
                                    </Button>
                                </Grid>
                                <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Left" Height="46" Margin="0,0,34,0">
                                    <TextBlock x:Name="PrimaryText" Text="{Binding PrimaryValue}" FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryTextBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="{StaticResource LabelFont}"/>
                                                <Setter Property="FontSize" Value="38"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PrimaryIsBytes}" Value="True">
                                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                                        <Setter Property="FontSize" Value="30"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Viewbox>
                                <ItemsControl ItemsSource="{Binding Notes}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <md:PackIcon Kind="InformationOutline" Width="14" Height="14" Margin="0,1,6,0"
                                                             Foreground="{DynamicResource KickerTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="12.5"
                                                           Foreground="{DynamicResource KickerTextBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- What the value means, read each way -->
                            <Rectangle Height="1" Fill="{DynamicResource HairlineBrush}" Margin="0,10,0,10"
                                       Visibility="{Binding HasReadings, Converter={StaticResource BoolToVisibility}}"/>
                            <ItemsControl ItemsSource="{Binding Readings}" ItemTemplate="{StaticResource ReadingTemplate}"
                                          Focusable="False"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================ keypad -->
        <!-- The Apple version's layout: A to D down the left, E and F beside the 0, then Clear,
             the sign key (Encode) and Backspace. -->
        <Grid Grid.Row="3" x:Name="Keypad" Margin="12,0,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource HexKey}" Content="A" Tag="A" Click="Key_Click" IsEnabled="{Binding HexKeysEnabled}"/>
            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource DigitKey}" Content="1" Tag="1" Click="Key_Click"/>
            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource DigitKey}" Content="2" Tag="2" Click="Key_Click"/>
            <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource DigitKey}" Content="3" Tag="3" Click="Key_Click"/>

            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource HexKey}" Content="B" Tag="B" Click="Key_Click" IsEnabled="{Binding HexKeysEnabled}"/>
            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource DigitKey}" Content="4" Tag="4" Click="Key_Click"/>
            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource DigitKey}" Content="5" Tag="5" Click="Key_Click"/>
            <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource DigitKey}" Content="6" Tag="6" Click="Key_Click"/>

            <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource HexKey}" Content="C" Tag="C" Click="Key_Click" IsEnabled="{Binding HexKeysEnabled}"/>
            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource DigitKey}" Content="7" Tag="7" Click="Key_Click"/>
            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource DigitKey}" Content="8" Tag="8" Click="Key_Click"/>
            <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource DigitKey}" Content="9" Tag="9" Click="Key_Click"/>

            <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource HexKey}" Content="D" Tag="D" Click="Key_Click" IsEnabled="{Binding HexKeysEnabled}"/>
            <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource HexKey}" Content="E" Tag="E" Click="Key_Click" IsEnabled="{Binding HexKeysEnabled}"/>
            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource HexKey}" Content="F" Tag="F" Click="Key_Click" IsEnabled="{Binding HexKeysEnabled}"/>
            <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource DigitKey}" Content="0" Tag="0" Click="Key_Click"/>

            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ClearKey" Style="{StaticResource DangerKey}"
                    Content="Clear" Click="Clear_Click" ToolTip="Clear (Esc)" AutomationProperties.Name="Clear"/>
            <Button Grid.Row="4" Grid.Column="2" x:Name="SignKey" Style="{StaticResource FunctionKey}" Click="Sign_Click"
                    IsEnabled="{Binding SignKeyEnabled}" ToolTip="Change the sign (-)" AutomationProperties.Name="Change the sign">
                <md:PackIcon Kind="PlusMinusVariant" Width="24" Height="24"/>
            </Button>
            <Button Grid.Row="4" Grid.Column="3" x:Name="BackspaceKey" Style="{StaticResource FunctionKey}" Click="Backspace_Click"
                    ToolTip="Backspace" AutomationProperties.Name="Backspace">
                <md:PackIcon Kind="BackspaceOutline" Width="24" Height="24"/>
            </Button>
        </Grid>

        <!-- ============================================================ status line -->
        <Border Grid.Row="4" Height="28" Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,70,0"/>
                <TextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontFamily="{StaticResource LabelFont}" FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}"/>
            </Grid>
        </Border>

        <!-- ============================================================ sheets -->
        <Grid x:Name="SheetHost" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed">
            <Rectangle Fill="{DynamicResource ScrimBrush}" MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>

            <!-- History -->
            <Border x:Name="HistorySheet" Margin="0,48,0,0" CornerRadius="{StaticResource SheetRadius}"
                    Background="{DynamicResource SheetBackgroundBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="1,1,1,0" Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="20,14,12,10">
                        <TextBlock Text="History" FontFamily="{StaticResource HeadFont}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SelectModeButton" Style="{StaticResource LinkButton}" Content="Select"
                                    Click="HistorySelectMode_Click" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" Click="CloseSheet_Click" ToolTip="Close (Esc)"
                                    AutomationProperties.Name="Close" Margin="6,0,0,0" Width="32" Height="32"
                                    Foreground="{DynamicResource SecondaryTextBrush}">
                                <md:PackIcon Kind="Close" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,2,10,4" Focusable="False">
                        <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource HistoryItemTemplate}" Focusable="False"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" x:Name="HistoryEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <md:PackIcon Kind="History" Width="44" Height="44" HorizontalAlignment="Center"
                                     Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="No calculations yet" FontSize="15" HorizontalAlignment="Center" Margin="0,12,0,4"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="Each result you stop on is added here" FontSize="12.5" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="20,10,14,12">
                        <Grid>
                            <!-- Browsing -->
                            <Grid x:Name="HistoryBrowseFooter">
                                <TextBlock x:Name="HistoryCountText" VerticalAlignment="Center" FontSize="12.5"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <Button x:Name="ClearAllButton" HorizontalAlignment="Right" Style="{StaticResource DangerLinkButton}"
                                        Content="Clear all" Click="HistoryClearAll_Click"/>
                            </Grid>
                            <!-- Selecting -->
                            <Grid x:Name="HistorySelectFooter" Visibility="Collapsed">
                                <TextBlock x:Name="HistorySelectedText" VerticalAlignment="Center" FontSize="12.5"
                                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="SelectAllButton" Style="{StaticResource LinkButton}" Content="Select all"
                                            Click="HistorySelectAll_Click" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button x:Name="DeleteSelectedButton" Style="{StaticResource DangerButton}" Content="Delete"
                                            Click="HistoryDeleteSelected_Click" MinHeight="32" Padding="16,4"/>
                                </StackPanel>
                            </Grid>
                            <!-- Confirming (inline, no dialog) -->
                            <Grid x:Name="HistoryConfirmFooter" Visibility="Collapsed">
                                <TextBlock x:Name="HistoryConfirmText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,0,180,0"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Click="HistoryConfirmCancel_Click"
                                            MinHeight="32" Padding="14,4" MinWidth="76" Margin="0,0,8,0"/>
                                    <Button x:Name="HistoryConfirmButton" Style="{StaticResource DangerButton}" Content="Delete"
                                            Click="HistoryConfirm_Click" MinHeight="32" Padding="14,4" MinWidth="76"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Settings -->
            <Border x:Name="SettingsSheet" VerticalAlignment="Bottom" CornerRadius="{StaticResource SheetRadius}"
                    Background="{DynamicResource SheetBackgroundBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="1,1,1,0" Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <StackPanel Margin="20,14,12,22">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Settings" FontFamily="{StaticResource HeadFont}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="CloseSheet_Click"
                                ToolTip="Close (Esc)" AutomationProperties.Name="Close" Width="32" Height="32"
                                Foreground="{DynamicResource SecondaryTextBrush}">
                            <md:PackIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </Grid>

                    <TextBlock Style="{StaticResource Kicker}" controls:Tracking.Text="SQLITE PAGE" Margin="0,8,0,4"/>
                    <TextBlock Text="The local payload depends on the page the cell is on." FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,8,12"/>

                    <TextBlock Text="Page size" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                    <UniformGrid x:Name="PageSizeChips" Columns="4" Margin="0,0,0,6"/>

                    <Grid Margin="0,4,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Reserved bytes" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBox x:Name="ReservedBox" Grid.Column="1" Width="64" Style="{StaticResource FieldTextBox}"
                                 MaxLength="3" TextChanged="ReservedBox_TextChanged" PreviewTextInput="ReservedBox_PreviewTextInput"
                                 AutomationProperties.Name="Reserved bytes per page"/>
                        <TextBlock Grid.Column="2" Text="Header offset 20; usually 0" FontSize="12" VerticalAlignment="Center"
                                   Margin="12,0,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                    </Grid>
                    <TextBlock x:Name="ReservedError" FontSize="12" Margin="0,6,8,0" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{DynamicResource ErrorTextBrush}"/>

                    <Grid Margin="0,14,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cell on" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Border Grid.Column="1" Style="{StaticResource SegmentTrack}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TableLeafOption" Style="{StaticResource Segment}" GroupName="BTree"
                                             Content="Table leaf" Checked="BTree_Checked"
                                             ToolTip="A table b-tree leaf cell (page type 0x0D): the rowid table case"/>
                                <RadioButton x:Name="IndexOption" Style="{StaticResource Segment}" GroupName="BTree"
                                             Content="Index" Checked="BTree_Checked"
                                             ToolTip="An index b-tree cell, leaf or interior (page types 0x0A and 0x02), as in WITHOUT ROWID tables"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Margin="0,14,8,0" Padding="12,9" CornerRadius="{StaticResource ControlRadius}"
                            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="PageFormulaText" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Border>

                    <TextBlock Style="{StaticResource Kicker}" controls:Tracking.Text="APPEARANCE" Margin="0,22,0,8"/>
                    <Border Style="{StaticResource SegmentTrack}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeDefaultOption" Style="{StaticResource Segment}" GroupName="Theme"
                                         Content="Default" Tag="Default" Checked="Theme_Checked"
                                         ToolTip="Firefly navy surfaces with the blue accent"/>
                            <RadioButton x:Name="ThemeDarkOption" Style="{StaticResource Segment}" GroupName="Theme"
                                         Content="Dark" Tag="Dark" Checked="Theme_Checked"/>
                            <RadioButton x:Name="ThemeLightOption" Style="{StaticResource Segment}" GroupName="Theme"
                                         Content="Light" Tag="Light" Checked="Theme_Checked"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
