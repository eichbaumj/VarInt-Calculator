<Window x:Class="VarIntCalculator.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:VarIntCalculator.Controls"
        Title="Varint Tutorial"
        Width="600" Height="720" MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SheetBackgroundBrush}"
        FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource RibbonBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,1">
                    <TextBlock Text="Varint" FontFamily="{StaticResource LabelFont}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource YellowBrush}"/>
                    <TextBlock Text="Tutorial" FontFamily="{StaticResource LabelFont}" FontSize="18"
                               Foreground="{StaticResource RibbonForegroundBrush}" Margin="5,0,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource DialogCaptionCloseButton}" Click="Close_Click"
                        ToolTip="Close (Esc)" AutomationProperties.Name="Close" WindowChrome.IsHitTestVisibleInChrome="True">
                    <md:PackIcon Kind="WindowClose" Width="16" Height="16"/>
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,16,24,4">
            <TextBlock x:Name="StepText" Style="{StaticResource Kicker}"/>
            <Grid Margin="0,8,0,0" Height="4">
                <Border CornerRadius="2" Background="{DynamicResource HairlineBrush}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ProgressDone" Width="1*"/>
                        <ColumnDefinition x:Name="ProgressLeft" Width="9*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="2" Background="{StaticResource AccentBrush}"/>
                </Grid>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="2" x:Name="BodyScroll" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="24,14,18,18">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontFamily="{StaticResource HeadFont}" FontSize="23" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <ContentControl x:Name="StepBody" Focusable="False"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="18,12,20,14">
            <Grid>
                <Button x:Name="RestartButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="Restart_Click"
                        ToolTip="Back to the first step">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Restart" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Start over"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PreviousButton" Style="{StaticResource SecondaryButton}" Click="Previous_Click" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ChevronLeft" Width="18" Height="18" VerticalAlignment="Center" Margin="-4,0,2,0"/>
                            <TextBlock Text="Previous"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}" Click="Next_Click" IsDefault="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="NextText" Text="Next"/>
                            <md:PackIcon x:Name="NextIcon" Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" Margin="2,0,-4,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
