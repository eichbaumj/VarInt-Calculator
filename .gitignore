# .NET build output directories
bin/
obj/

# Visual Studio files
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.dbmdl
*.dbproj.schemaview
*.pfx
*.publishsettings
**/Properties/launchSettings.json

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/packages/*
# except build/, which is used as an MSBuild target.
!**/packages/build/

# Executables, including the 3.0 installer (releases carry the installers)
*.exe

# Others
.DS_Store
Thumbs.db
*.bak
*.cache
*.log

# Python reference file
varint_calculator.py
icon.py

# Git helper scripts
push_to_github.bat

# Build and installer scripts
build_and_run.bat

# Installer output (setup\Build-Installer.ps1)
Installer/ 
# Review previews written by the setup scripts
setup/art/preview-*.png
setup/art/icon-preview.png
